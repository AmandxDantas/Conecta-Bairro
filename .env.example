# Copie para .env e carregue as variáveis no seu shell antes de executar.
# Gere uma chave própria para produção; a chave abaixo não é real.
SECRET_KEY=troque-por-uma-chave-aleatoria-forte
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Ative somente em ambientes servidos exclusivamente por HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
